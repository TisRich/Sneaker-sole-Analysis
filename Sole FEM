clc;
clear;
close all;

%% STEP 1: Define STL Files

files = {'FlatS.STL', 'CurvedS.STL'};
names = {'Flat Sole', 'Curved Sole'};

% Store both models and meshes
Solemodel = cell(1, 2);
meshes = cell(1, 2);

% STL geometry is assumed to be in centimeters
stlScale = 0.01;  % cm to meters

% Dimensions measured directly in SolidWorks (cm)
% [X Y Z]
% NaN means the dimensions have not been verified yet.
expected_cm = [
    NaN NaN NaN;    % Flat Sole
    NaN NaN NaN     % Curved Sole
];

% Preliminary mesh settings
Hmax = 0.002;             % 10 mm after conversion
meshOrder = 'linear';    % Faster preliminary mesh

% Change to false to skip mesh visualization
showMesh = true;

%% STEP 2: Import and Verify Geometry

for i = 1:numel(files)

    fprintf('\n-----------------------------\n');
    fprintf('Processing %s\n', names{i});
    fprintf('-----------------------------\n');

    % Create static structural model
    Solemodel{i} = createpde('structural', 'static-solid');

    % Import STL geometry
    importGeometry(Solemodel{i}, files{i});

    % Get geometric vertices
    V = Solemodel{i}.Geometry.Vertices;

    % Ensure vertices are N x 3
    if size(V, 2) ~= 3
        if size(V, 1) == 3
            V = V';
        else
            error('Unexpected vertex array dimensions for %s.', ...
                  names{i});
        end
    end

    % Calculate dimensions before scaling
    dimensions_cm = max(V, [], 1) - min(V, [], 1);

    fprintf('\nImported dimensions (assuming cm):\n');
    fprintf('X = %.3f cm\n', dimensions_cm(1));
    fprintf('Y = %.3f cm\n', dimensions_cm(2));
    fprintf('Z = %.3f cm\n', dimensions_cm(3));

    fprintf('Number of faces: %d\n', ...
            Solemodel{i}.Geometry.NumFaces);

    %% STEP 3: Validate Dimensions (Warning Approach)

    if any(isnan(expected_cm(i,:)))

        warning(['Dimensions for %s have not been verified ', ...
                 'against SolidWorks. Continuing with ', ...
                 'preliminary mesh testing only.'], names{i});

    else

        % Calculate relative error
        relativeError = abs(dimensions_cm - expected_cm(i,:)) ...
                        ./ expected_cm(i,:);

        % Stop only when supplied dimensions disagree
        if any(relativeError > 0.01)
            error(['Geometry dimensions do not match ', 'SolidWorks for %s.'], names{i});
        end

        fprintf('Geometry dimensions verified successfully.\n');

    end

    %% STEP 4: Display Geometry and Face Numbers

    figure;

    pdegplot(Solemodel{i},'FaceLabels', 'on', 'FaceAlpha', 0.5);

    axis equal;
    view(3);
    title([names{i}, ' - Face Identification']);

    %% STEP 5: Convert Geometry to Meters

    % Convert from cm to m for SI-based FEA
    
%% Correct geometry and convert to meters

% Divide X, Y   and Z by 10
axisCorrection = [0.1, 0.1, 0.1];

% Apply coordinate correction
scale(Solemodel{i}.Geometry, axisCorrection);

% Convert all dimensions from cm to meters
scale(Solemodel{i}.Geometry, 0.01);

% Check corrected dimensions
V = Solemodel{i}.Geometry.Vertices;

if size(V, 2) ~= 3
    V = V';
end

dimensions_m = max(V, [], 1) - min(V, [], 1);
dimensions_cm = dimensions_m * 100;

fprintf('\nCorrected dimensions for %s:\n', names{i});
fprintf('X = %.3f cm\n', dimensions_cm(1));
fprintf('Y = %.3f cm\n', dimensions_cm(2));
fprintf('Z = %.3f cm\n', dimensions_cm(3));


    %% STEP 6: Generate Preliminary Mesh

    meshes{i} = generateMesh(Solemodel{i},'Hmax', Hmax,'GeometricOrder', meshOrder);
    fprintf('Number of nodes: %d\n',size(meshes{i}.Nodes, 2));
    fprintf('Number of elements: %d\n', size(meshes{i}.Elements, 2));

end

%% STEP 7: Display Both Meshes

if showMesh

    for i = 1:numel(files)

        figure;

        pdeplot3D(meshes{i});

        axis equal;
        view(3);

        title([names{i}, ' - Preliminary Mesh']);

    end

end

%% STEP 8: Summary

fprintf('\n====================================\n');
fprintf('PRELIMINARY MESH GENERATION COMPLETE\n');
fprintf('====================================\n');

fprintf('Models processed: %d\n', numel(files));
fprintf('Mesh size Hmax: %.1f mm\n', Hmax * 1000);
fprintf('Mesh order: %s\n', meshOrder);

fprintf('\nIMPORTANT:\n');
fprintf('Verify geometry dimensions and face IDs before FEA.\n');
fprintf('No forces, fixtures, or materials have been applied.\n');



%% STATIC MIDFOOT FEA
% Run after importing and meshing both STL models.
% No additional mesh generation.

E = 25e6;                  % Young's modulus (Pa)
nu = 0.48;                 % Poisson's ratio
F = 1946;                  % Total force per sole (N)

names = {'Flat Sole', 'Curved Sole'};
loadFaces = {[1 27], 3};   % Flat and curved loading faces

% Assumes Z points upward
loadDirection = [0; 0; -1];

results = cell(1,2);
stressMPa = zeros(2,1);
dispMM = zeros(2,1);
loadArea = zeros(2,1);

for i = 1:2

    model = Solemodel{i};
    msh = model.Mesh;

    assert(~isempty(msh), 'Mesh is missing.');

    % Current area calculation requires linear tetrahedral mesh
    assert(size(msh.Elements,1) == 4, 'This code requires a linear tetrahedral mesh.');

    %% 1. Material

    structuralProperties(model, 'YoungsModulus', E,'PoissonsRatio', nu);

    %% 2. Boundary Conditions

    % Earlier selection: fix every face except loaded faces
    fixedFaces = setdiff(1:model.Geometry.NumFaces, loadFaces{i});

    assert(all(loadFaces{i} >= 1) && all(loadFaces{i} <= model.Geometry.NumFaces), 'Invalid loading face ID.');

    assert(~isempty(fixedFaces),'No fixed faces selected.');

    structuralBC(model,'Face', fixedFaces,'Constraint', 'fixed');

    %% 3. Calculate Loading Area

    % Exterior triangular faces of the tetrahedral mesh
    TR = triangulation(msh.Elements', msh.Nodes');
    surfaceTriangles = freeBoundary(TR);

    % Find nodes on selected loading faces
    loadNodes = [];

    for f = loadFaces{i}
        nodes = findNodes(msh, 'region', 'Face', f);

        loadNodes = [loadNodes; nodes(:)];
    end

    loadNodes = unique(loadNodes);

    % Select exterior triangles on loading region
    mask = all(ismember(surfaceTriangles, loadNodes), 2);

    tri = surfaceTriangles(mask,:);

    assert(~isempty(tri), ...
        'No loading triangles found.');

    P = msh.Nodes';

    v1 = P(tri(:,2),:) - P(tri(:,1),:);
    v2 = P(tri(:,3),:) - P(tri(:,1),:);

    A = sum(0.5 * vecnorm( ...
        cross(v1,v2,2), 2, 2));

    assert(isfinite(A) && A > 0, 'Invalid loading area.');

    loadArea(i) = A;

    fprintf('\n%s\n', names{i});
    fprintf('Loading area: %.6f m^2\n', A);

    %% 4. Visualize Loading Region

    figure;
    trisurf(tri, P(:,1), P(:,2), P(:,3),'FaceColor', 'red', 'EdgeColor', 'blue');

    axis equal;
    view(3);
    title([names{i}, ' - Selected Loading Region']);

    % Confirm the highlighted area is the intended
    % upper loading surface before accepting results.

    %% 5. Apply Distributed Force

    traction = F / A;

    structuralBoundaryLoad(model, ...
        'Face', loadFaces{i}, ...
        'SurfaceTraction', traction*loadDirection);

    fprintf('Applied total target force: %.1f N\n', F);
    fprintf('Surface traction: %.2f Pa\n', traction);

    %% 6. Solve Static FEA

    results{i} = solve(model);

    %% 7. Extract Results

    stressMPa(i) = max(results{i}.VonMisesStress)/1e6;

    dispMM(i) = .max(results{i}.Displacement.Magnitude)*1000;

    fprintf('Maximum von Mises: %.3f MPa\n',stressMPa(i));

    fprintf('Maximum displacement: %.3f mm\n', dispMM(i));

    %% 8. Von Mises Stress Plot

    figure;

    pdeplot3D(results{i}.Mesh, 'ColorMapData', results{i}.VonMisesStress/1e6);

    axis equal;
    view(3);
    colorbar;

    title([names{i}, ' - Midfoot Von Mises Stress (MPa)']);

    %% 9. Displacement Plot

    figure;

    pdeplot3D(results{i}.Mesh, 'ColorMapData', results{i}.Displacement.Magnitude*1000);

    axis equal;
    view(3);
    colorbar;

    title([names{i}, ' - Midfoot Displacement (mm)']);

end

%% 10. Summary Table

summary = table( string(names(:)),  repmat(F,2,1), loadArea, ...
    stressMPa, dispMM, 'VariableNames', { 'Sole', ...
    'Force_N',  'LoadingArea_m2', 'MaxStress_MPa', 'MaxDisplacement_mm'});

disp(summary);

% Export numerical results
writetable(summary, 'Midfoot_FEA_Results.xlsx');
